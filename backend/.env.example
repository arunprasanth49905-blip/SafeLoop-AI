# SafeLoop AI Backend Environment Configuration
# Copy this file to .env and adjust variables as needed

APP_NAME="SafeLoop AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Allowed CORS Origins (JSON array format or comma-separated URLs)
# In production on Render, set this to include your exact Vercel domain:
# ALLOWED_ORIGINS="https://your-safeloop-app.vercel.app,http://localhost:5173"
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Gemini AI Provider Configuration (Phase 2+)
# Set your Gemini API key from Google AI Studio (e.g. AIzaSy...)
# Never commit real API keys to version control.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
